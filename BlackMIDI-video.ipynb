import mido
import cv2
import numpy as np
import subprocess
import colorsys
import random
from google.colab import files

# --- 設定パラメータ ---
MIDI_FILE = "imput.mid" #@param {type:"string"}
AUDIO_FILE = "audio.wav" #@param {type:"string"}
OUTPUT_FILE = "final_video.mp4" #@param {type:"string"}

WIDTH = 1920 #@param {type:"integer"}
HEIGHT = 1080 #@param {type:"integer"}
FPS = 30 #@param {type:"integer"}
TIME_WINDOW = 4.0 #@param {type:"number"}

# 重要：生成スクリプトに合わせる
PITCH_RANGE = 2 #@param {type:"integer"}

# レンダリングモード
# Horizontal_RtoL, Horizontal_LtoR, Vertical_Falling, Vertical_Rising
RENDER_MODE = "Horizontal_RtoL" #@param ["Horizontal_RtoL", "Horizontal_LtoR", "Vertical_Falling", "Vertical_Rising"]

# 視覚設定
ENABLE_VELOCITY = True #@param {type:"boolean"}
SHOW_PIANO = True #@param {type:"boolean"}
SHOW_NAMES = True #@param {type:"boolean"}

# 色設定 (Random, Single, Rainbow)
COLOR_MODE = "Random" #@param ["Random", "Single", "Rainbow"]
BASE_COLOR_HEX = "#00FF00" # Singleの場合のみ有効

# --- 関数定義 ---

def hex_to_bgr(hex_col):
    hex_col = hex_col.lstrip('#')
    rgb = tuple(int(hex_col[i:i+2], 16) for i in (0, 2, 4))
    return (rgb[2], rgb[1], rgb[0])

def get_color_for_note(channel, note, velocity):
    if COLOR_MODE == "Single":
        base_bgr = hex_to_bgr(BASE_COLOR_HEX)
    elif COLOR_MODE == "Rainbow":
        hue = (note % 12) / 12.0
        r, g, b = colorsys.hsv_to_rgb(hue, 0.8, 1.0)
        base_bgr = (int(b*255), int(g*255), int(r*255))
    else: # Random
        random.seed(channel * 100)
        base_bgr = (random.randint(50,255), random.randint(50,255), random.randint(50,255))
    
    if ENABLE_VELOCITY:
        factor = 0.3 + 0.7 * (velocity / 127.0)
        return (int(base_bgr[0]*factor), int(base_bgr[1]*factor), int(base_bgr[2]*factor))
    return base_bgr

def render_video():
    if not os.path.exists(MIDI_FILE):
        print(f"エラー: {MIDI_FILE} が見つかりません。アップロードしてください。")
        return

    # 音声ファイル名の確認（なければダミーで進めるが、今回はある前提）
    has_audio = os.path.exists(AUDIO_FILE)
    if not has_audio:
        print(f"警告: 音声ファイル {AUDIO_FILE} が見つかりません。映像のみ生成します。")

    print("MIDIを解析中...")
    mid = mido.MidiFile(MIDI_FILE)
    
    # ピッチベンドとノート情報の収集
    bend_times = {ch: [0.0] for ch in range(16)}
    bend_values = {ch: [0.0] for ch in range(16)}
    notes = []
    active_notes = {}
    
    min_note, max_note = 21, 108
    abs_time = 0.0

    # 余白設定 (固定)
    m_top, m_btm, m_left, m_right = 50, 50, 150, 50

    for msg in mid:
        abs_time += msg.time
        
        if msg.type == 'pitchwheel':
            val = (msg.pitch - 8192) / 8192.0 * PITCH_RANGE
            bend_times[msg.channel].append(abs_time)
            bend_values[msg.channel].append(val)
        
        elif msg.type == 'note_on' and msg.velocity > 0:
            key = (msg.channel, msg.note)
            active_notes[key] = {'start': abs_time, 'vel': msg.velocity}
            
        elif (msg.type == 'note_off') or (msg.type == 'note_on' and msg.velocity == 0):
            key = (msg.channel, msg.note)
            if key in active_notes:
                d = active_notes.pop(key)
                if min_note <= msg.note <= max_note:
                    col = get_color_for_note(msg.channel, msg.note, d['vel'])
                    notes.append({
                        'note': msg.note, 'start': d['start'], 'end': abs_time,
                        'ch': msg.channel, 'vel': d['vel'], 'color': col
                    })

    duration = abs_time + 3.0
    total_frames = int(duration * FPS)
    print(f"総フレーム数: {total_frames} (約 {duration:.1f} 秒)")
    print(f"総ノート数: {len(notes)}")

    # 描画設定
    draw_w = WIDTH - m_left - m_right
    draw_h = HEIGHT - m_top - m_btm
    total_keys = max_note - min_note + 1
    
    is_vertical = "Vertical" in RENDER_MODE
    is_reverse = "LtoR" in RENDER_MODE or "Rising" in RENDER_MODE

    if is_vertical:
        key_step = draw_w / total_keys
        px_per_sec = draw_h / TIME_WINDOW
        hit_line = (HEIGHT - m_btm) if not is_reverse else m_top
    else:
        key_step = draw_h / total_keys
        px_per_sec = draw_w / TIME_WINDOW
        hit_line = m_left if not is_reverse else (WIDTH - m_right)

    # ビデオ出力 (ColabではMJPG推奨)
    temp_video = "temp_video.avi"
    fourcc = cv2.VideoWriter_fourcc(*'MJPG')
    out = cv2.VideoWriter(temp_video, fourcc, FPS, (WIDTH, HEIGHT))

    print("レンダリング開始 (時間がかかります)...")
    
    # 進捗表示用
    step = total_frames // 10 if total_frames > 10 else 1

    def is_black(n): return (n % 12) in [1, 3, 6, 8, 10]
    def get_name(n): return ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"][n%12] + str(n//12-1)

    for f in range(total_frames):
        if f % step == 0: print(f"  {f}/{total_frames} frames ({(f/total_frames)*100:.1f}%)")
        
        now = f / FPS
        img = np.full((HEIGHT, WIDTH, 3), (20, 20, 20), dtype=np.uint8)
        
        vis_min, vis_max = now - TIME_WINDOW, now + TIME_WINDOW

        # ノート描画
        for n in notes:
            if n['end'] < vis_min or n['start'] > vis_max: continue

            # ポリゴン計算 (簡易化のためstep固定)
            t_points = np.linspace(n['start'], n['end'], num=5) # 頂点数を減らして高速化
            
            # ピッチベンド補間
            b_vals = np.interp(t_points, bend_times[n['ch']], bend_values[n['ch']])
            dt_arr = t_points - now
            base_idx = n['note'] - min_note
            
            # 座標計算
            if not is_vertical:
                keys_arr = m_top + (max_note - (n['note'] + b_vals)) * key_step
            else:
                keys_arr = m_left + (base_idx + b_vals) * key_step
            
            k_thick = key_step + 1
            poly_pts = []

            if is_vertical:
                ys = hit_line - dt_arr * px_per_sec if not is_reverse else hit_line + dt_arr * px_per_sec
                pts_L = np.column_stack((keys_arr, ys)).astype(np.int32)
                pts_R = np.column_stack((keys_arr + k_thick, ys)).astype(np.int32)
                poly_pts = np.vstack((pts_L, pts_R[::-1]))
            else:
                xs = hit_line + dt_arr * px_per_sec if not is_reverse else hit_line - dt_arr * px_per_sec
                pts_T = np.column_stack((xs, keys_arr)).astype(np.int32)
                pts_B = np.column_stack((xs, keys_arr + k_thick)).astype(np.int32)
                poly_pts = np.vstack((pts_T, pts_B[::-1]))

            # 発音中エフェクト
            col = n['color']
            if n['start'] <= now < n['end']:
                col = tuple([min(255, c + 150) for c in col])
            
            cv2.fillPoly(img, [poly_pts], col)

        # マージンと鍵盤 (簡略化)
        cv2.rectangle(img, (0,0), (m_left, HEIGHT), (15,15,15), -1) # 左マージン
        # (他のマージン省略可、必要なら追加)

        # 判定線
        lpos = int(hit_line)
        if not is_vertical:
             cv2.line(img, (lpos, 0), (lpos, HEIGHT), (200,200,200), 1)
             # 鍵盤描画
             if SHOW_PIANO:
                for i in range(total_keys):
                    nn = max_note - i
                    ky = int(m_top + i * key_step)
                    c = (40,40,40) if is_black(nn) else (230,230,230)
                    cv2.rectangle(img, (0, ky), (m_left, ky+int(key_step)+1), c, -1)
                    if SHOW_NAMES and not is_black(nn) and nn%12==0:
                         cv2.putText(img, get_name(nn), (5, ky+int(key_step*0.7)), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (0,0,0), 1)

        out.write(img)

    out.release()
    print("映像生成完了。結合中...")

    # 音声結合
    cmd = [
        'ffmpeg', '-y', '-i', temp_video,
        '-i', AUDIO_FILE if has_audio else 'anullsrc', # 音声がない場合は無音
        '-c:v', 'libx264', '-pix_fmt', 'yuv420p', '-preset', 'fast', '-crf', '18',
        '-c:a', 'aac', '-b:a', '192k', '-shortest', OUTPUT_FILE
    ]
    subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    
    print(f"全ての処理が完了しました: {OUTPUT_FILE}")
    files.download(OUTPUT_FILE)

# 実行
render_video()
